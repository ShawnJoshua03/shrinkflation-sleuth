# Elasticsearch cluster (an Elastic Cloud trial or a local Docker node works)
ES_URL=https://your-deployment.es.us-central1.gcp.cloud.es.io:443
ES_API_KEY=your_elasticsearch_api_key

# Google Cloud / Gemini (ADK uses Vertex AI or AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Or, for AI Studio instead of Vertex:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your_ai_studio_key

# Optional: Gemini model id. Check the Vertex AI model lifecycle page if the
# default has been retired.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: HTTP-mode Elastic MCP server (recommended on Cloud Run).
# If unset, the agent spawns agents/shrinkflation_sleuth/es_mcp_server.py
# locally over stdio (no Docker needed).
# ELASTIC_MCP_URL=https://your-elastic-mcp-service.run.app/mcp
